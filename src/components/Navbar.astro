---
import { Image } from 'astro:assets';
import logoImg from '../assets/images/logo_profile.jpg';
---

<header class="sticky top-0 z-40 w-full bg-[#080a09]/85 backdrop-blur-xl border-b border-emerald-950/70 transition-all duration-300 shadow-[0_4px_30px_rgba(0,0,0,0.6)]">
  <!-- Subtle Soft Bottom Diffusion Gradient -->
  <div class="absolute -bottom-2.5 left-0 right-0 h-2.5 bg-gradient-to-b from-[#080a09]/40 to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 relative">
      
      <!-- Brand / Logo with Organic Root Filaments Detail -->
      <a href="#hero" class="relative flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded-xl p-1.5 transition-transform duration-200">
        
        <!-- Botanical Root Filaments SVG Weaving Behind the Brand -->
        <svg
          class="absolute -bottom-2 -left-2 w-28 h-14 pointer-events-none text-emerald-500/25 group-hover:text-emerald-400/50 transition-colors duration-300 overflow-visible"
          viewBox="0 0 100 50"
          fill="none"
          aria-hidden="true"
        >
          <!-- Primary root trunk descending from logo -->
          <path
            d="M 22 14 C 18 24, 10 34, 2 40"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
          <!-- Secondary branch weaving under the text -->
          <path
            d="M 22 14 C 26 26, 38 35, 56 42"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
          />
          <!-- Distant root tendril -->
          <path
            d="M 32 24 C 44 28, 66 31, 88 35"
            stroke="currentColor"
            stroke-width="1.1"
            stroke-linecap="round"
            stroke-dasharray="2 3"
          />
          <!-- Little root bud -->
          <circle cx="56" cy="42" r="1.5" fill="currentColor" />
          <circle cx="88" cy="35" r="1.2" fill="currentColor" />
        </svg>

        <div class="relative z-10">
          <Image
            src={logoImg}
            alt="Logo Quincho Raíces"
            class="w-11 h-11 rounded-full object-cover border-2 border-emerald-500/70 shadow-[0_0_12px_rgba(16,185,129,0.35)] transition-transform duration-300 group-hover:scale-105"
            width={44}
            height={44}
            loading="eager"
          />
          <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-400 border-2 border-[#080a09] rounded-full shadow-[0_0_6px_rgba(52,211,153,0.8)]"></span>
        </div>

        <div class="flex flex-col text-left relative z-10">
          <span class="font-serif text-xl sm:text-2xl font-bold tracking-tight text-stone-100 leading-none group-hover:text-emerald-300 transition-colors">
            Quincho Raíces
          </span>
          <span class="text-[11px] font-medium text-emerald-400/80 tracking-wide mt-1">
            La Punta, San Luis
          </span>
        </div>
      </a>

      <!-- Desktop Navigation with Botanical Micro-underlines -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
        {[
          { href: '#amenities', label: 'Lo que ofrecemos' },
          { href: '#galeria', label: 'Galería' },
          { href: '#eventos', label: 'Eventos' },
          { href: '#ubicacion', label: 'Ubicación' },
          { href: '#faq', label: 'Preguntas' },
        ].map((item) => (
          <a
            href={item.href}
            class="relative px-3 py-2 rounded-md text-sm font-medium text-stone-300 hover:text-emerald-300 hover:bg-emerald-950/40 transition-colors group"
          >
            <span>{item.label}</span>
            <span class="absolute bottom-1 left-3 right-3 h-[2px] bg-gradient-to-r from-emerald-400 to-teal-300 rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
          </a>
        ))}
      </nav>


      <!-- Mobile Menu Toggle Button -->
      <div class="flex md:hidden">
        <button
          id="mobile-menu-button"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="p-2.5 rounded-lg text-stone-300 hover:text-white hover:bg-emerald-950/50 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-colors"
        >
          <span class="sr-only">Abrir menú</span>
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>


  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-emerald-900/50 bg-[#0c100e]/98 px-4 pt-2 pb-6 space-y-2 backdrop-blur-xl shadow-2xl animate-in fade-in slide-in-from-top-2 duration-200">
    <a href="#amenities" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-medium text-stone-200 hover:bg-emerald-950/60 hover:text-emerald-300">
      Lo que ofrecemos
    </a>
    <a href="#galeria" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-medium text-stone-200 hover:bg-emerald-950/60 hover:text-emerald-300">
      Galería
    </a>
    <a href="#eventos" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-medium text-stone-200 hover:bg-emerald-950/60 hover:text-emerald-300">
      Eventos
    </a>
    <a href="#ubicacion" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-medium text-stone-200 hover:bg-emerald-950/60 hover:text-emerald-300">
      Ubicación
    </a>
    <a href="#faq" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-medium text-stone-200 hover:bg-emerald-950/60 hover:text-emerald-300">
      Preguntas Frecuentes
    </a>

  </div>
</header>

<script>
  // Mobile Menu Toggle
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu() {
    const isHidden = menu?.classList.contains('hidden');
    if (isHidden) {
      menu?.classList.remove('hidden');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      button?.setAttribute('aria-expanded', 'true');
    } else {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      button?.setAttribute('aria-expanded', 'false');
    }
  }

  button?.addEventListener('click', toggleMenu);

  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      button?.setAttribute('aria-expanded', 'false');
    });
  });

</script>
