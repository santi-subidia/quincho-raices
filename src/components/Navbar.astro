---
import { Image } from 'astro:assets';
import logoImg from '../assets/images/logo_profile.jpg';
import { CONTACT_LINES, buildWhatsAppLink } from '../data/quincho';
import { MessageCircle } from 'lucide-react';

const primaryContact = CONTACT_LINES[0];
const ctaWhatsApp = buildWhatsAppLink(
  primaryContact.phoneRaw,
  '¡Hola! Me comunico desde el sitio web de Quincho Raíces para consultar por disponibilidad de fechas.'
);
---

<header class="sticky top-0 z-40 w-full bg-white/90 backdrop-blur-md border-b border-stone-200/80 transition-all duration-300 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 relative">
      
      <!-- Brand / Logo with Organic Root Filaments Detail -->
      <a href="#hero" class="relative flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded-xl p-1.5 transition-transform duration-200">
        
        <!-- Botanical Root Filaments SVG Weaving Behind the Brand -->
        <svg
          class="absolute -bottom-2 -left-2 w-28 h-14 pointer-events-none text-emerald-600/15 group-hover:text-emerald-600/30 transition-colors duration-300 overflow-visible"
          viewBox="0 0 100 50"
          fill="none"
          aria-hidden="true"
        >
          <!-- Primary root trunk descending from logo -->
          <path
            d="M 22 14 C 18 24, 10 34, 2 40"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
          <!-- Secondary branch weaving under the text -->
          <path
            d="M 22 14 C 26 26, 38 35, 56 42"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
          />
          <!-- Distant root tendril -->
          <path
            d="M 32 24 C 44 28, 66 31, 88 35"
            stroke="currentColor"
            stroke-width="1.1"
            stroke-linecap="round"
            stroke-dasharray="2 3"
          />
          <!-- Little root bud -->
          <circle cx="56" cy="42" r="1.5" fill="currentColor" />
          <circle cx="88" cy="35" r="1.2" fill="currentColor" />
        </svg>

        <div class="relative z-10">
          <Image
            src={logoImg}
            alt="Logo Quincho Raíces"
            class="w-11 h-11 rounded-full object-cover border-2 border-emerald-600/40 shadow-sm transition-transform duration-300 group-hover:scale-105"
            width={44}
            height={44}
            loading="eager"
          />
          <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-500 border-2 border-white rounded-full shadow-xs"></span>
        </div>

        <div class="flex flex-col text-left relative z-10">
          <span class="font-serif text-xl sm:text-2xl font-bold tracking-tight text-stone-900 leading-none group-hover:text-emerald-700 transition-colors">
            Quincho Raíces
          </span>
          <span class="text-[11px] font-semibold text-emerald-700 tracking-wide mt-1">
            La Punta, San Luis
          </span>
        </div>
      </a>

      <!-- Desktop Navigation with Botanical Micro-underlines -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
        {[
          { href: '#amenities', label: 'Instalaciones' },
          { href: '#galeria', label: 'Galería' },
          { href: '#eventos', label: 'Eventos' },
          { href: '#ubicacion', label: 'Ubicación' },
          { href: '#faq', label: 'Preguntas' },
        ].map((item) => (
          <a
            href={item.href}
            class="relative px-3 py-2 rounded-lg text-sm font-medium text-stone-600 hover:text-emerald-700 hover:bg-emerald-50/70 transition-colors group"
          >
            <span>{item.label}</span>
            <span class="absolute bottom-1 left-3 right-3 h-[2px] bg-emerald-600 rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left"></span>
          </a>
        ))}
      </nav>

      <!-- Desktop CTA Button -->
      <div class="hidden lg:flex items-center">
        <a
          href={ctaWhatsApp}
          target="_blank"
          rel="noopener noreferrer"
          class="shimmer-sweep inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white text-xs sm:text-sm font-semibold shadow-md shadow-emerald-600/20 transition-all transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <MessageCircle className="w-4 h-4 text-emerald-100" />
          <span>Consultar por WhatsApp</span>
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex md:hidden">
        <button
          id="mobile-menu-button"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="p-2.5 rounded-xl text-stone-700 hover:text-emerald-700 hover:bg-emerald-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-colors"
        >
          <span class="sr-only">Abrir menú</span>
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-stone-200 bg-white/98 px-4 pt-3 pb-6 space-y-2 backdrop-blur-xl shadow-lg animate-in fade-in slide-in-from-top-2 duration-200">
    <a href="#amenities" class="mobile-nav-link block px-3.5 py-2.5 rounded-xl text-base font-medium text-stone-700 hover:bg-emerald-50 hover:text-emerald-700">
      Instalaciones
    </a>
    <a href="#galeria" class="mobile-nav-link block px-3.5 py-2.5 rounded-xl text-base font-medium text-stone-700 hover:bg-emerald-50 hover:text-emerald-700">
      Galería
    </a>
    <a href="#eventos" class="mobile-nav-link block px-3.5 py-2.5 rounded-xl text-base font-medium text-stone-700 hover:bg-emerald-50 hover:text-emerald-700">
      Eventos
    </a>
    <a href="#ubicacion" class="mobile-nav-link block px-3.5 py-2.5 rounded-xl text-base font-medium text-stone-700 hover:bg-emerald-50 hover:text-emerald-700">
      Ubicación
    </a>
    <a href="#faq" class="mobile-nav-link block px-3.5 py-2.5 rounded-xl text-base font-medium text-stone-700 hover:bg-emerald-50 hover:text-emerald-700">
      Preguntas Frecuentes
    </a>

    <div class="pt-3">
      <a
        href={ctaWhatsApp}
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-link flex items-center justify-center gap-2 w-full px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm shadow-md shadow-emerald-600/20"
      >
        <MessageCircle className="w-4 h-4" />
        <span>Consultar por WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile Menu Toggle
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu() {
    const isHidden = menu?.classList.contains('hidden');
    if (isHidden) {
      menu?.classList.remove('hidden');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      button?.setAttribute('aria-expanded', 'true');
    } else {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      button?.setAttribute('aria-expanded', 'false');
    }
  }

  button?.addEventListener('click', toggleMenu);

  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      button?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
