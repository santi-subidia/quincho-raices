---
import { CONTACT_LINES, buildWhatsAppLink } from '../data/quincho';
import { Phone } from 'lucide-react';

const primaryPhone = CONTACT_LINES[0];
const primaryWhatsApp = buildWhatsAppLink(primaryPhone.phoneRaw, '¡Hola! Me comunico desde la web para consultar por disponibilidad de fechas en Quincho Raíces.');
---

<header class="sticky top-0 z-40 w-full border-b border-stone-200/80 bg-white/90 backdrop-blur-md transition-all duration-200 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand / Logo -->
      <a href="#" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-brand-500 rounded-lg p-1">
        <div class="relative">
          <img
            src="/images/logo_profile.jpg"
            alt="Logo Quincho Raíces"
            class="w-11 h-11 rounded-full object-cover border-2 border-brand-600 shadow-sm transition-transform duration-300 group-hover:scale-105"
            width="44"
            height="44"
          />
          <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-500 border-2 border-white rounded-full"></span>
        </div>
        <div class="flex flex-col text-left">
          <span class="font-serif text-xl sm:text-2xl font-bold tracking-tight text-stone-900 leading-none group-hover:text-brand-700 transition-colors">
            Quincho Raíces
          </span>
          <span class="text-[11px] font-medium text-stone-600 tracking-wide mt-1">
            La Punta, San Luis
          </span>
        </div>
      </a>

      <!-- Desktop Navigation with Botanical Micro-underlines -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
        {[
          { href: '#amenities', label: 'Instalaciones' },
          { href: '#galeria', label: 'Galería' },
          { href: '#eventos', label: 'Eventos' },
          { href: '#cotizador', label: 'Cotizador' },
          { href: '#ubicacion', label: 'Ubicación' },
          { href: '#faq', label: 'Preguntas' },
        ].map((item) => (
          <a
            href={item.href}
            class="relative px-3 py-2 rounded-md text-sm font-medium text-stone-700 hover:text-brand-700 hover:bg-emerald-50/50 transition-colors group"
          >
            <span>{item.label}</span>
            <span class="absolute bottom-1 left-3 right-3 h-[2px] bg-emerald-600 rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left"></span>
          </a>
        ))}
      </nav>

      <!-- CTA WhatsApp Desktop with Shimmer Micro-interaction -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href={primaryWhatsApp}
          target="_blank"
          rel="noopener noreferrer"
          class="shimmer-sweep inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-brand-700 hover:bg-brand-800 text-white font-semibold text-sm shadow-sm hover:shadow-md hover:shadow-brand-900/20 transition-all duration-200 transform hover:-translate-y-0.5 active:translate-y-0 focus:ring-2 focus:ring-brand-500 focus:ring-offset-2"
        >
          <Phone className="w-4 h-4" />
          <span>Consultar Fecha</span>
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex md:hidden">
        <button
          id="mobile-menu-button"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="p-2.5 rounded-lg text-stone-700 hover:text-stone-900 hover:bg-stone-100 focus:outline-none focus:ring-2 focus:ring-brand-500 transition-colors"
        >
          <span class="sr-only">Abrir menú</span>
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Organic Scroll Progress Root on Navbar Bottom Edge -->
  <div class="absolute bottom-0 left-0 right-0 h-[2.5px] bg-stone-100 overflow-hidden pointer-events-none">
    <div
      id="navbar-root-progress"
      class="h-full bg-gradient-to-r from-emerald-600 via-emerald-400 to-teal-400 w-0 transition-[width] duration-100 ease-out shadow-[0_0_8px_rgba(52,211,153,0.8)]"
    ></div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-stone-200 bg-white/95 px-4 pt-2 pb-6 space-y-2 backdrop-blur-md shadow-lg animate-in fade-in slide-in-from-top-2 duration-200">
    <a href="#amenities" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-medium text-stone-800 hover:bg-emerald-50 hover:text-emerald-900">
      Instalaciones
    </a>
    <a href="#galeria" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-medium text-stone-800 hover:bg-emerald-50 hover:text-emerald-900">
      Galería
    </a>
    <a href="#eventos" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-medium text-stone-800 hover:bg-emerald-50 hover:text-emerald-900">
      Eventos
    </a>
    <a href="#cotizador" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-medium text-stone-800 hover:bg-emerald-50 hover:text-emerald-900">
      Cotizador de Fecha
    </a>
    <a href="#ubicacion" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-medium text-stone-800 hover:bg-emerald-50 hover:text-emerald-900">
      Ubicación
    </a>
    <a href="#faq" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-medium text-stone-800 hover:bg-emerald-50 hover:text-emerald-900">
      Preguntas Frecuentes
    </a>
    <div class="pt-3 border-t border-stone-200">
      <a
        href={primaryWhatsApp}
        target="_blank"
        rel="noopener noreferrer"
        class="shimmer-sweep flex items-center justify-center gap-2 w-full px-4 py-3 rounded-xl bg-brand-700 text-white font-semibold shadow-sm active:bg-brand-800"
      >
        <Phone className="w-5 h-5" />
        <span>Escribir por WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile Menu Toggle
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu() {
    const isHidden = menu?.classList.contains('hidden');
    if (isHidden) {
      menu?.classList.remove('hidden');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      button?.setAttribute('aria-expanded', 'true');
    } else {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      button?.setAttribute('aria-expanded', 'false');
    }
  }

  button?.addEventListener('click', toggleMenu);

  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      button?.setAttribute('aria-expanded', 'false');
    });
  });

  // Sync Navbar Scroll Progress Bar
  const navProgress = document.getElementById('navbar-root-progress');
  function updateNavProgress() {
    if (!navProgress) return;
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    if (docHeight > 0) {
      const percentage = Math.min(Math.max((scrollTop / docHeight) * 100, 0), 100);
      navProgress.style.width = `${percentage}%`;
    }
  }

  window.addEventListener('scroll', updateNavProgress, { passive: true });
  updateNavProgress();
</script>
