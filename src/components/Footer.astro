---
import { Image } from 'astro:assets';
import { QUINCHO_INFO, CONTACT_LINES, buildWhatsAppLink } from '../data/quincho';
import { Phone, MapPin, Heart } from 'lucide-react';
import MountainSilhouette from './MountainSilhouette.astro';
import logoImg from '../assets/images/logo_profile.jpg';

const currentYear = new Date().getFullYear();
---

<footer class="bg-stone-950 text-stone-300 relative">
  <!-- Mountain Silhouette Transition from FAQ into Footer -->
  <div class="relative w-full bg-white leading-none">
    <MountainSilhouette variant="night" fillColor="#0c0a09" />
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10">
      
      <!-- Brand & Description (5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <Image
            src={logoImg}
            alt="Logo Quincho Raíces"
            class="w-12 h-12 rounded-full object-cover border-2 border-emerald-500 shadow-md shadow-emerald-950/40"
            width={48}
            height={48}
            loading="lazy"
          />
          <div>
            <span class="font-serif text-2xl font-bold tracking-tight text-white block">
              {QUINCHO_INFO.name}
            </span>
            <span class="text-xs font-semibold text-emerald-400">
              {QUINCHO_INFO.tagline}
            </span>
          </div>
        </div>

        <p class="text-sm text-stone-400 max-w-md leading-relaxed">
          {QUINCHO_INFO.description}
        </p>

        <!-- Social Media Link (Instagram SVG) -->
        <div class="pt-2">
          <a
            href={QUINCHO_INFO.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-stone-200 text-sm font-semibold transition-colors group"
          >
            <svg class="w-4 h-4 text-pink-400 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
            <span>Seguinos en Instagram <strong class="text-pink-300 font-bold">{QUINCHO_INFO.social.handle}</strong></span>
          </a>
        </div>
      </div>

      <!-- Quick Links (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="text-sm font-bold uppercase tracking-wider text-white">Navegación</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="#amenities" class="text-stone-400 hover:text-emerald-400 transition-colors">
              Instalaciones & Comodidades
            </a>
          </li>
          <li>
            <a href="#galeria" class="text-stone-400 hover:text-emerald-400 transition-colors">
              Galería de Fotos
            </a>
          </li>
          <li>
            <a href="#eventos" class="text-stone-400 hover:text-emerald-400 transition-colors">
              Tipos de Festejo
            </a>
          </li>
          <li>
            <a href="#cotizador" class="text-stone-400 hover:text-emerald-400 transition-colors">
              Cotizador Online
            </a>
          </li>
          <li>
            <a href="#ubicacion" class="text-stone-400 hover:text-emerald-400 transition-colors">
              Ubicación & Accesos
            </a>
          </li>
          <li>
            <a href="#faq" class="text-stone-400 hover:text-emerald-400 transition-colors">
              Preguntas Frecuentes
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact Lines (4 cols) -->
      <div class="lg:col-span-4 space-y-3">
        <h4 class="text-sm font-bold uppercase tracking-wider text-white">Líneas de Atención</h4>
        <div class="space-y-3">
          {CONTACT_LINES.map((line) => {
            const url = buildWhatsAppLink(
              line.phoneRaw,
              '¡Hola Quincho Raíces! Me comunico desde el sitio web.'
            );
            return (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 p-3 rounded-2xl bg-stone-900 border border-stone-800 hover:border-emerald-500/50 transition-colors group"
              >
                <div class="p-2 rounded-xl bg-emerald-950 text-emerald-400 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                  <Phone className="w-4 h-4" />
                </div>
                <div>
                  <p class="text-xs font-bold text-stone-300">{line.name}</p>
                  <p class="text-sm font-mono font-semibold text-white group-hover:text-emerald-400 transition-colors">
                    {line.phoneFormatted}
                  </p>
                </div>
              </a>
            );
          })}
        </div>

        <div class="flex items-center gap-2 text-xs text-stone-400 pt-2">
          <MapPin className="w-4 h-4 text-emerald-400 flex-shrink-0" />
          <span>{QUINCHO_INFO.location.fullAddress}</span>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-stone-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-stone-500 gap-4">
      <p>&copy; {currentYear} {QUINCHO_INFO.name}. Todos los derechos reservados.</p>
      <p class="flex items-center gap-1">
        <span>Diseñado con</span>
        <Heart className="w-3.5 h-3.5 text-rose-500 fill-rose-500" />
        <span>para celebrar tus mejores momentos en San Luis</span>
      </p>
    </div>

  </div>
</footer>
