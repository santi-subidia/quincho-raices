---
import { FAQS } from '../data/quincho';
import { HelpCircle, ChevronDown } from 'lucide-react';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": FAQS.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section id="faq" class="py-20 bg-white border-t border-stone-200 relative">
  <!-- FAQ Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="reveal-item text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold tracking-wide uppercase mb-3 shadow-2xs">
        <HelpCircle className="w-3.5 h-3.5" />
        <span>Dudas Frecuentes</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900 tracking-tight mb-4">
        Preguntas frecuentes sobre el alquiler
      </h2>
      <p class="text-base sm:text-lg text-stone-600">
        Respondemos las preguntas más habituales para que reserves con total tranquilidad y confianza.
      </p>
    </div>

    <!-- Smooth Accordion List -->
    <div class="space-y-4">
      {FAQS.map((item, index) => {
        const delayClass = index === 0 ? '' : index === 1 ? 'reveal-delay-100' : 'reveal-delay-200';
        return (
          <details
            class={`reveal-item ${delayClass} faq-accordion group bg-stone-50/90 rounded-2xl border border-stone-200/80 overflow-hidden transition-all duration-300 open:bg-emerald-50/30 open:border-emerald-300 shadow-2xs hover:border-emerald-200`}
            open={index === 0}
          >
            <summary class="flex items-center justify-between p-5 sm:p-6 text-left cursor-pointer select-none font-bold text-stone-900 group-open:text-emerald-950 hover:text-emerald-700 transition-colors">
              <span class="text-base sm:text-lg pr-4">{item.question}</span>
              <div class="p-1.5 rounded-full bg-stone-200/70 group-open:bg-emerald-200 text-stone-700 group-open:text-emerald-800 transition-transform duration-300 group-open:rotate-180 flex-shrink-0 shadow-2xs">
                <ChevronDown className="w-4 h-4" />
              </div>
            </summary>
            <div class="faq-content">
              <div class="faq-content-inner px-5 pb-6 pt-2 sm:px-6 text-sm sm:text-base text-stone-600 leading-relaxed border-t border-stone-200/50 group-open:border-emerald-200/60">
                {item.answer}
              </div>
            </div>
          </details>
        );
      })}
    </div>

  </div>
</section>
