---
import { FAQS } from '../data/quincho';
import { HelpCircle, ChevronDown } from 'lucide-react';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": FAQS.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section id="faq" class="py-20 sm:py-28 bg-[#080a09] border-t border-emerald-950/40 relative">
  <!-- FAQ Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="reveal-item text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-950/80 text-emerald-300 text-xs font-bold tracking-wide uppercase mb-3.5 border border-emerald-500/30 shadow-[0_0_15px_rgba(16,185,129,0.2)]">
        <HelpCircle className="w-3.5 h-3.5 text-emerald-400" />
        <span>Dudas Frecuentes</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-stone-100 tracking-tight mb-4">
        Preguntas frecuentes sobre el alquiler
      </h2>
      <p class="text-base sm:text-lg text-stone-300 leading-relaxed">
        Respondemos las preguntas más habituales para que reserves con total tranquilidad y confianza.
      </p>
    </div>

    <!-- Smooth Accordion List -->
    <div class="space-y-4">
      {FAQS.map((item, index) => {
        const delayClass = index === 0 ? '' : index === 1 ? 'reveal-delay-100' : 'reveal-delay-200';
        return (
          <details
            class={`reveal-item ${delayClass} faq-accordion group bg-[#0d1310]/85 backdrop-blur-xl rounded-2xl border border-emerald-950/80 overflow-hidden transition-all duration-300 open:bg-[#121a15] open:border-emerald-500/50 shadow-md hover:border-emerald-800/60`}
            open={index === 0}
          >
            <summary class="flex items-center justify-between p-5 sm:p-6 text-left cursor-pointer select-none font-serif font-bold text-stone-100 group-open:text-emerald-300 hover:text-emerald-400 transition-colors">
              <span class="text-base sm:text-lg pr-4">{item.question}</span>
              <div class="p-2 rounded-full bg-[#141e17] group-open:bg-emerald-950 text-stone-300 group-open:text-emerald-300 border border-emerald-900/40 transition-transform duration-300 group-open:rotate-180 flex-shrink-0 shadow-2xs">
                <ChevronDown className="w-4 h-4" />
              </div>
            </summary>
            <div class="faq-content">
              <div class="faq-content-inner px-5 pb-6 pt-2 sm:px-6 text-sm sm:text-base text-stone-300 leading-relaxed border-t border-emerald-950/60 group-open:border-emerald-900/40">
                {item.answer}
              </div>
            </div>
          </details>
        );
      })}
    </div>

  </div>
</section>
