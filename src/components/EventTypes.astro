---
import { EVENT_TYPES, CONTACT_LINES, buildWhatsAppLink } from '../data/quincho';
import TreeEmblemWatermark from './TreeEmblemWatermark.astro';
import { PartyPopper, Beef, MoonStar, Briefcase, Heart, MessageCircle, Sparkles } from 'lucide-react';

const iconMap: Record<string, any> = {
  PartyPopper,
  Beef,
  MoonStar,
  Briefcase,
  Heart,
};

const [lineRocio, lineMatias] = CONTACT_LINES;
---

<section id="eventos" class="py-20 sm:py-28 bg-[#080a09] relative overflow-hidden">
  <!-- Botanical Tree Watermark Background -->
  <TreeEmblemWatermark className="top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px]" opacity={0.035} strokeColor="#34d399" />

  <div class="max-w-3xl mx-auto px-4 sm:px-6 relative z-10">
    
    <!-- Section Header (Minimal & Natural) -->
    <div class="reveal-item text-center max-w-xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-emerald-950/80 text-emerald-300 text-xs font-bold tracking-wide uppercase mb-3 border border-emerald-500/30 shadow-[0_0_15px_rgba(16,185,129,0.2)]">
        <Sparkles className="w-3 h-3 text-emerald-400" />
        <span>Celebraciones & Festejos</span>
      </div>
      <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-stone-100 tracking-tight mb-3">
        ¿Para qué es ideal?
      </h2>
      <p class="text-xs sm:text-sm text-stone-300 leading-relaxed">
        Cada festejo es único. Conocé cómo se adapta nuestro espacio exclusivo y consultanos directamente.
      </p>
    </div>

    <!-- Sticky Stacking Solapas (Luxury Dark Invitation Cards) -->
    <div class="relative space-y-0 pb-12">
      {EVENT_TYPES.map((eventType, index) => {
        const IconComponent = iconMap[eventType.icon] || PartyPopper;
        
        const rocioUrl = buildWhatsAppLink(
          lineRocio.phoneRaw,
          `¡Hola Rocío! Quisiera consultar disponibilidad para celebrar: ${eventType.title} en Quincho Raíces.`
        );
        const matiasUrl = buildWhatsAppLink(
          lineMatias.phoneRaw,
          `¡Hola Matías! Quisiera consultar disponibilidad para celebrar: ${eventType.title} en Quincho Raíces.`
        );

        // Generous top clearance so it never crowds the navbar, plus clear steps
        const mobileOffset = 6.25 + index * 2.25; // rem (100px base + 36px step)
        const desktopOffset = 6.5 + index * 2.75; // rem (104px base + 44px step)
        const zIndex = 10 + index;
        const isNotLast = index < EVENT_TYPES.length - 1;

        return (
          <div
            style={`--m-top: ${mobileOffset}rem; --d-top: ${desktopOffset}rem; z-index: ${zIndex};`}
            class={`sticky top-[var(--m-top)] sm:top-[var(--d-top)] transition-all duration-200 ${
              isNotLast ? 'mb-24 sm:mb-32' : 'mb-6'
            }`}
          >
            <!-- Card Shell: Dark glass with fine metallic jewel border -->
            <div class={`bg-[#0d1310]/95 backdrop-blur-xl rounded-2xl border ${eventType.accent.border} shadow-[0_10px_35px_rgba(0,0,0,0.7)] hover:shadow-[0_15px_45px_rgba(0,0,0,0.9)] overflow-hidden transition-all duration-300`}>
              
              <!-- Tab / Solapa Bar: Tinted dark metal background -->
              <div class={`flex items-center justify-between px-4 sm:px-6 py-2.5 sm:py-3.5 ${eventType.accent.tabBg} border-b transition-colors`}>
                <div class="flex items-center gap-2.5">
                  <span class={`inline-flex items-center justify-center px-2 py-0.5 rounded text-[11px] font-mono font-bold ${eventType.accent.tabNumber}`}>
                    {eventType.number}
                  </span>
                  <span class="font-serif text-sm sm:text-base font-bold text-stone-100">
                    {eventType.tabTitle}
                  </span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-[11px] text-stone-400 font-medium hidden sm:inline">{eventType.tagline}</span>
                  <IconComponent className={`w-4 h-4 ${eventType.accent.iconColor}`} />
                </div>
              </div>

              <!-- Card Content: Editorial Dark Luxury -->
              <div class="p-4 sm:p-6 space-y-3.5 bg-[#0b100d]/90">
                <h3 class="font-serif text-base sm:text-lg font-bold text-stone-100 leading-snug">
                  {eventType.title}
                </h3>

                <p class="text-xs sm:text-sm text-stone-300 leading-relaxed font-normal">
                  {eventType.idealFor}
                </p>

                <!-- WhatsApp Quick Action Buttons -->
                <div class="pt-3 border-t border-emerald-950/60 flex items-center justify-between flex-wrap gap-2.5">
                  <span class="text-[11px] font-medium text-stone-400">
                    Consultar fecha por WhatsApp:
                  </span>
                  <div class="flex items-center gap-2">
                    <a
                      href={rocioUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="shimmer-sweep inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-700 hover:bg-emerald-600 text-white text-xs font-semibold shadow-[0_0_12px_rgba(16,185,129,0.25)] transition-all"
                    >
                      <MessageCircle className="w-3.5 h-3.5 text-emerald-200" />
                      <span>Con Rocío</span>
                    </a>
                    <a
                      href={matiasUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#141d18] hover:bg-emerald-950/80 text-stone-200 hover:text-white border border-emerald-900/60 hover:border-emerald-500/40 text-xs font-semibold shadow-2xs transition-colors"
                    >
                      <MessageCircle className="w-3.5 h-3.5 text-emerald-400" />
                      <span>Con Matías</span>
                    </a>
                  </div>
                </div>

              </div>

            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
