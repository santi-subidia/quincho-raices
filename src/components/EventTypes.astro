---
import { EVENT_TYPES, CONTACT_LINES, buildWhatsAppLink } from '../data/quincho';
import { PartyPopper, Beef, MoonStar, Briefcase, Check, ArrowRight } from 'lucide-react';

const iconMap: Record<string, any> = {
  PartyPopper,
  Beef,
  MoonStar,
  Briefcase,
};

const defaultPhone = CONTACT_LINES[0];
---

<section id="eventos" class="py-20 bg-stone-100/70 border-t border-b border-stone-200/80 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="reveal-item text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold tracking-wide uppercase mb-3 shadow-2xs">
        Celebraciones & Momentos
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900 tracking-tight mb-4">
        ¿Qué tipo de festejo estás planeando?
      </h2>
      <p class="text-base sm:text-lg text-stone-600">
        Adaptamos nuestro espacio para que vos solo te ocupes de disfrutar junto a tus invitados.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      {EVENT_TYPES.map((eventType, index) => {
        const IconComponent = iconMap[eventType.icon] || PartyPopper;
        const eventWhatsAppUrl = buildWhatsAppLink(
          defaultPhone.phoneRaw,
          `¡Hola! Quisiera consultar disponibilidad y presupuesto para festejar un evento de tipo: ${eventType.title}.`
        );
        const delayClass = index === 0 ? '' : index === 1 ? 'reveal-delay-100' : index === 2 ? 'reveal-delay-200' : 'reveal-delay-300';

        return (
          <div class={`reveal-item ${delayClass} spotlight-card flex flex-col bg-white rounded-3xl p-7 border border-stone-200/80 shadow-xs hover:shadow-xl hover:border-emerald-400/80 hover:-translate-y-1.5 transition-all duration-300 group cursor-default`}>
            
            <!-- Icon & Header -->
            <div class="p-3 rounded-2xl bg-emerald-50 text-emerald-700 border border-emerald-100 w-fit mb-5 group-hover:bg-emerald-600 group-hover:text-white group-hover:scale-110 group-hover:rotate-3 transition-all duration-300 shadow-2xs">
              <IconComponent className="w-6 h-6" />
            </div>

            <h3 class="text-xl font-bold text-stone-900 mb-1 group-hover:text-emerald-800 transition-colors">
              {eventType.title}
            </h3>
            
            <p class="text-xs font-semibold text-emerald-700 mb-4">
              {eventType.tagline}
            </p>

            <p class="text-sm text-stone-600 mb-6 leading-relaxed flex-1">
              {eventType.description}
            </p>

            <!-- Benefits List -->
            <div class="space-y-2 mb-6 pt-4 border-t border-stone-100">
              {eventType.benefits.map((b) => (
                <div class="flex items-center gap-2 text-xs font-medium text-stone-700">
                  <Check className="w-3.5 h-3.5 text-emerald-600 flex-shrink-0 group-hover:scale-110 transition-transform" />
                  <span>{b}</span>
                </div>
              ))}
            </div>

            <!-- Recommended Shift Badge -->
            <div class="mb-6 p-2.5 rounded-xl bg-stone-50 border border-stone-200/60 text-xs text-stone-600 text-center group-hover:bg-emerald-50/50 group-hover:border-emerald-200/60 transition-colors">
              <span class="font-bold text-stone-800">Horario sugerido:</span><br />
              {eventType.recommendedShifts}
            </div>

            <!-- CTA with sliding arrow -->
            <a
              href={eventWhatsAppUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="shimmer-sweep inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-stone-100 hover:bg-emerald-600 text-stone-800 hover:text-white font-semibold text-xs tracking-wide transition-all duration-200 transform active:scale-98"
            >
              <span>Consultar este plan</span>
              <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform duration-200" />
            </a>

          </div>
        );
      })}
    </div>

  </div>
</section>
