---
import { WHY_CHOOSE_US } from '../data/quincho';
import TreeEmblemWatermark from './TreeEmblemWatermark.astro';
import {
  Mountain,
  Users,
  Waves,
  ChefHat,
  Check,
  Sparkles,
} from 'lucide-react';

const iconMap: Record<string, any> = {
  Mountain,
  Users,
  Waves,
  ChefHat,
};
---

<section id="amenities" class="py-20 sm:py-28 bg-[#f8faf9] relative border-b border-stone-200/80 scroll-mt-20 overflow-hidden">
  <!-- Subtle Botanical Watermark for depth -->
  <TreeEmblemWatermark className="top-12 -right-32 md:right-10 w-[550px] h-[550px]" opacity={0.035} strokeColor="#059669" />
  <TreeEmblemWatermark className="-bottom-32 -left-32 w-[500px] h-[500px]" opacity={0.025} strokeColor="#10b981" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header: "¿Por qué elegir Quincho Raíces?" estilo Vivanco -->
    <div class="reveal-item text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-50 text-emerald-800 text-xs font-bold tracking-wide uppercase mb-3.5 border border-emerald-200 shadow-xs">
        <Sparkles className="w-3.5 h-3.5 text-emerald-600" />
        <span>Instalaciones & Comodidad</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-stone-900 tracking-tight mb-4 text-balance">
        ¿Por qué elegir Quincho Raíces?
      </h2>
      <p class="text-base sm:text-lg text-stone-600 leading-relaxed max-w-2xl mx-auto">
        Espacio exclusivo en planta baja para hasta 40 personas. Todo pensado para que tu festejo sea cómodo, privado y sin sorpresas.
      </p>
    </div>

    <!-- Grid de 4 Tarjetas Claras y Luminosas -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      {WHY_CHOOSE_US.map((item, index) => {
        const ItemIcon = iconMap[item.icon] || Sparkles;
        const delayClass = index % 2 === 0 ? 'reveal-delay-100' : 'reveal-delay-200';

        return (
          <div
            class={`reveal-item ${delayClass} bg-white rounded-3xl p-6 sm:p-8 border border-stone-200/80 shadow-md shadow-stone-200/50 hover:shadow-xl hover:border-emerald-300 transition-all duration-300 flex flex-col justify-between group`}
          >
            <div>
              <!-- Top Row: Icono Circular de Color Vivo + Badge + Número -->
              <div class="flex items-center justify-between gap-3 mb-6">
                <div class="flex items-center gap-3.5">
                  <div class={`w-13 h-13 rounded-2xl ${item.iconBg} flex items-center justify-center shadow-md group-hover:scale-105 transition-transform duration-300`}>
                    <ItemIcon className="w-6 h-6" />
                  </div>
                  <div>
                    <span class={`inline-block text-xs font-bold px-3 py-1 rounded-full border ${item.badgeColor}`}>
                      {item.badge}
                    </span>
                  </div>
                </div>
                <span class="text-xs font-mono font-bold text-stone-400 group-hover:text-emerald-600 transition-colors">
                  0{index + 1}/04
                </span>
              </div>

              <!-- Title & Short Description (Yendo al grano) -->
              <h3 class="text-xl sm:text-2xl font-serif font-bold text-stone-900 mb-2 leading-snug group-hover:text-emerald-700 transition-colors">
                {item.title}
              </h3>
              <p class="text-sm text-stone-600 leading-relaxed mb-6">
                {item.description}
              </p>
            </div>

            <!-- Bullet points concisos de 1 línea -->
            <div class="space-y-2.5 pt-4 border-t border-stone-100">
              {item.highlights.map((highlight) => (
                <div class="flex items-center gap-2.5 text-xs sm:text-sm text-stone-700 font-medium">
                  <div class="w-5 h-5 rounded-full bg-emerald-100 flex items-center justify-center shrink-0">
                    <Check className="w-3.5 h-3.5 text-emerald-700" />
                  </div>
                  <span>{highlight}</span>
                </div>
              ))}
            </div>

          </div>
        );
      })}
    </div>

  </div>
</section>
