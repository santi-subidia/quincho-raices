---
import { Image } from 'astro:assets';
import { AMENITIES } from '../data/quincho';
import {
  Users,
  Waves,
  Flame,
  UtensilsCrossed,
  CheckCircle2,
  Speaker,
  ThermometerSun,
  ShieldCheck,
  Check
} from 'lucide-react';

import salonImg from '../assets/images/salon_interior_banquet.jpg';
import poolImg from '../assets/images/pool_mountains.jpg';
import grillImg from '../assets/images/parrilla_churrasquera.jpg';
import kitchenImg from '../assets/images/kitchen_dining.jpg';
import tablewareImg from '../assets/images/salon_panoramic.jpg';
import soundImg from '../assets/images/sound_jbl_party.jpg';
import heaterImg from '../assets/images/sunset_terrace.jpg';
import parkingImg from '../assets/images/pool_tree_window.jpg';

const amenityImages: Record<string, ImageMetadata> = {
  salon: salonImg,
  pool: poolImg,
  grill: grillImg,
  kitchen: kitchenImg,
  tableware: tablewareImg,
  sound: soundImg,
  heater: heaterImg,
  parking: parkingImg,
};

const iconMap: Record<string, any> = {
  Users,
  Waves,
  Flame,
  UtensilsCrossed,
  CheckCircle2,
  Speaker,
  ThermometerSun,
  ShieldCheck,
};
---

<section id="amenities" class="py-20 bg-stone-50 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="reveal-item text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold tracking-wide uppercase mb-3 shadow-2xs">
        Instalaciones & Comodidades
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900 tracking-tight mb-4">
        Todo lo que necesitás para que tu evento sea perfecto
      </h2>
      <p class="text-base sm:text-lg text-stone-600">
        Diseñado y equipado para brindarte confort, seguridad y la mejor vista a las sierras puntanas en cada momento.
      </p>
    </div>

    <!-- Featured Amenities Grid (Card with Photo + Details) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      {AMENITIES.slice(0, 6).map((amenity, index) => {
        const IconComponent = iconMap[amenity.icon] || Check;
        const delayClass = index % 3 === 0 ? '' : index % 3 === 1 ? 'reveal-delay-100' : 'reveal-delay-200';
        const imgObj = amenityImages[amenity.id];
        return (
          <div class={`reveal-item ${delayClass} spotlight-card group flex flex-col bg-white rounded-3xl overflow-hidden border border-stone-200/80 shadow-xs hover:shadow-xl hover:-translate-y-1.5 hover:border-emerald-300/80 transition-all duration-300 cursor-default`}>
            {imgObj && (
              <div class="relative h-52 w-full overflow-hidden bg-stone-100">
                <Image
                  src={imgObj}
                  alt={amenity.title}
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-108"
                  loading="lazy"
                  widths={[400, 800]}
                  sizes="(max-width: 768px) 100vw, 400px"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-stone-950/70 via-stone-950/20 to-transparent"></div>
                <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-white">
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-stone-900/70 backdrop-blur-md border border-white/20 shadow-xs">
                    {amenity.subtitle}
                  </span>
                </div>
              </div>
            )}
            
            <div class="p-6 flex-1 flex flex-col">
              <div class="flex items-center gap-3 mb-3">
                <div class="p-2.5 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-100 group-hover:bg-emerald-600 group-hover:text-white group-hover:rotate-3 transition-all duration-300 shadow-2xs">
                  <IconComponent className="w-5 h-5" />
                </div>
                <h3 class="text-xl font-bold text-stone-900 group-hover:text-emerald-800 transition-colors">
                  {amenity.title}
                </h3>
              </div>
              <p class="text-sm text-stone-600 leading-relaxed flex-1">
                {amenity.description}
              </p>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Additional Amenities Row (2 items: Heater & Parking) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {AMENITIES.slice(6, 8).map((amenity, index) => {
        const IconComponent = iconMap[amenity.icon] || Check;
        const delayClass = index === 0 ? '' : 'reveal-delay-100';
        const imgObj = amenityImages[amenity.id];
        return (
          <div class={`reveal-item ${delayClass} spotlight-card flex flex-col sm:flex-row items-center gap-6 p-6 rounded-3xl bg-white border border-stone-200/80 shadow-xs hover:shadow-lg hover:-translate-y-1 hover:border-emerald-300/80 transition-all duration-300 group cursor-default`}>
            {imgObj && (
              <Image
                src={imgObj}
                alt={amenity.title}
                class="w-full sm:w-36 h-32 rounded-2xl object-cover transition-transform duration-500 group-hover:scale-105"
                width={144}
                height={128}
                loading="lazy"
              />
            )}
            <div class="flex-1 text-left">
              <div class="flex items-center gap-2 mb-1">
                <div class="p-1.5 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-100 group-hover:bg-emerald-600 group-hover:text-white transition-colors duration-200">
                  <IconComponent className="w-4 h-4" />
                </div>
                <h4 class="text-lg font-bold text-stone-900 group-hover:text-emerald-800 transition-colors">{amenity.title}</h4>
              </div>
              <p class="text-xs font-semibold text-emerald-700 uppercase tracking-wide mb-2">{amenity.subtitle}</p>
              <p class="text-sm text-stone-600 leading-relaxed">{amenity.description}</p>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
