---
import { QUINCHO_INFO, CONTACT_LINES, buildWhatsAppLink } from '../data/quincho';
import { MapPin, Navigation, Compass, ExternalLink, Shield, Mountain, Car } from 'lucide-react';
import TopographicLines from './TopographicLines.astro';

const primaryPhone = CONTACT_LINES[0];
const locationWhatsApp = buildWhatsAppLink(
  primaryPhone.phoneRaw,
  '¡Hola! Quisiera que me envíen la ubicación exacta por WhatsApp para coordinar una visita a Quincho Raíces.'
);
---

<section id="ubicacion" class="py-20 sm:py-28 bg-[#0c100e] border-t border-emerald-950/40 relative overflow-hidden">
  <!-- Mountain Topographic Elevation Lines Background -->
  <TopographicLines opacity={0.08} strokeColor="#34d399" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="reveal-item text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-950/80 text-emerald-300 text-xs font-bold tracking-wide uppercase mb-3.5 border border-emerald-500/30 shadow-[0_0_15px_rgba(16,185,129,0.2)]">
        <MapPin className="w-3.5 h-3.5 text-emerald-400" />
        <span>Entorno & Accesos</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-stone-100 tracking-tight mb-4">
        Ubicación privilegiada en La Punta
      </h2>
      <p class="text-base sm:text-lg text-stone-300 leading-relaxed">
        Enclavado en el Barrio Aires de San Benito, combinando tranquilidad serrana, aire puro y rápido acceso desde San Luis capital y alrededores.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Info & Quick Access Cards (5 cols) -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-6">
        
        <div class="reveal-item spotlight-card spotlight-card-dark bg-[#101713]/90 backdrop-blur-xl rounded-3xl p-7 border border-emerald-900/30 shadow-[0_10px_35px_rgba(0,0,0,0.6)] hover:border-emerald-500/50 transition-all duration-300 space-y-6">
          
          <div class="flex items-start gap-4">
            <div class="p-3 rounded-2xl bg-emerald-950 text-emerald-400 border border-emerald-800/40 flex-shrink-0 shadow-2xs">
              <MapPin className="w-6 h-6 animate-pulse" />
            </div>
            <div>
              <h3 class="text-lg font-serif font-bold text-stone-100">Barrio Aires de San Benito</h3>
              <p class="text-sm text-stone-300 mt-1">
                La Punta, San Luis, Argentina.
              </p>
              <p class="text-xs text-emerald-400/90 mt-2 font-medium">
                Zona residencial calma, segura y rodeada de naturaleza serrana.
              </p>
            </div>
          </div>

          <!-- Key Highlights -->
          <div class="space-y-3 pt-4 border-t border-emerald-950/60">
            <div class="flex items-center gap-3 text-sm text-stone-300 group">
              <Mountain className="w-4 h-4 text-emerald-400 flex-shrink-0 group-hover:scale-110 transition-transform" />
              <span>Vista franca a las sierras de San Luis</span>
            </div>
            <div class="flex items-center gap-3 text-sm text-stone-300 group">
              <Car className="w-4 h-4 text-emerald-400 flex-shrink-0 group-hover:scale-110 transition-transform" />
              <span>Acceso rápido por avenidas principales</span>
            </div>
            <div class="flex items-center gap-3 text-sm text-stone-300 group">
              <Shield className="w-4 h-4 text-emerald-400 flex-shrink-0 group-hover:scale-110 transition-transform" />
              <span>Estacionamiento cerrado dentro del predio</span>
            </div>
          </div>

          <!-- Navigation Action Buttons with Shimmer & Slide -->
          <div class="pt-4 border-t border-emerald-950/60 space-y-2.5">
            <a
              href={QUINCHO_INFO.location.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="shimmer-sweep flex items-center justify-between w-full px-4 py-3 rounded-xl bg-[#141e17] hover:bg-emerald-950 text-white text-sm font-semibold border border-emerald-900/60 hover:border-emerald-500/40 transition-all duration-200 transform hover:-translate-y-0.5 shadow-sm group"
            >
              <div class="flex items-center gap-2">
                <Navigation className="w-4 h-4 text-emerald-400 group-hover:rotate-45 transition-transform duration-200" />
                <span>Abrir en Google Maps</span>
              </div>
              <ExternalLink className="w-4 h-4 text-emerald-400/70 group-hover:text-emerald-400 group-hover:translate-x-0.5 transition-all" />
            </a>

            <a
              href={QUINCHO_INFO.location.wazeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="shimmer-sweep flex items-center justify-between w-full px-4 py-3 rounded-xl bg-sky-950/80 hover:bg-sky-900/80 text-white text-sm font-semibold border border-sky-800/50 hover:border-sky-500/50 transition-all duration-200 transform hover:-translate-y-0.5 shadow-sm group"
            >
              <div class="flex items-center gap-2">
                <Compass className="w-4 h-4 text-sky-400 group-hover:rotate-45 transition-transform duration-200" />
                <span>Navegar con Waze</span>
              </div>
              <ExternalLink className="w-4 h-4 text-sky-400/70 group-hover:text-sky-400 group-hover:translate-x-0.5 transition-all" />
            </a>
          </div>

        </div>

        <!-- WhatsApp Location Request -->
        <div class="reveal-item reveal-delay-100 bg-[#0e1612]/90 rounded-3xl p-6 border border-emerald-800/40 shadow-md hover:border-emerald-500/40 transition-colors">
          <h4 class="text-sm font-bold text-emerald-300 mb-1">
            ¿Querés venir a conocer el espacio?
          </h4>
          <p class="text-xs text-stone-300 mb-3">
            Escribinos y coordinamos una visita previa para que veas las instalaciones personalmente.
          </p>
          <a
            href={locationWhatsApp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-xs font-bold text-emerald-400 hover:text-emerald-300 underline group"
          >
            <span>Pedir ubicación exacta por WhatsApp</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </a>
        </div>

      </div>

      <!-- Map Embed Container (7 cols) -->
      <div class="reveal-item reveal-delay-200 lg:col-span-7 bg-[#101713] rounded-3xl overflow-hidden border border-emerald-900/30 shadow-[0_10px_35px_rgba(0,0,0,0.6)] hover:shadow-2xl transition-all duration-300 min-h-[360px] lg:min-h-full flex flex-col">
        <div class="p-4 bg-[#0a0e0c] border-b border-emerald-950/60 flex items-center justify-between text-xs text-stone-300">
          <span class="font-semibold text-stone-200">Ubicación Oficial &bull; Quincho Raíces</span>
          <span class="px-2.5 py-0.5 rounded-full bg-emerald-950 text-emerald-300 border border-emerald-800/40 font-medium">Verificado en Google Maps</span>
        </div>
        <div class="relative flex-1 w-full min-h-[350px]">
          <iframe
            title="Ubicación oficial de Quincho Raíces en Google Maps"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13342.304561081682!2d-66.295939!3d-33.2113916!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95d44196ae259ed7%3A0x3b00648b627a6fe!2sQuincho%20%E2%80%9CRa%C3%ADces%E2%80%9D!5e0!3m2!1ses-419!2sar!4v1710972000000!5m2!1ses-419!2sar"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-full min-h-[350px]"
          ></iframe>
        </div>
      </div>

    </div>

  </div>
</section>
