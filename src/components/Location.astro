---
import { Image } from 'astro:assets';
import { QUINCHO_INFO, CONTACT_LINES, buildWhatsAppLink } from '../data/quincho';
import { MapPin, Navigation, Compass, ExternalLink, Shield, Mountain, Car } from 'lucide-react';
import TopographicLines from './TopographicLines.astro';
import rootBranch3Emerald from '../assets/images/roots/root_branch_3_emerald.png';
import rootWatercolor2 from '../assets/images/roots/root_watercolor_2.png';

const primaryPhone = CONTACT_LINES[0];
const locationWhatsApp = buildWhatsAppLink(
  primaryPhone.phoneRaw,
  '¡Hola! Quisiera que me envíen la ubicación exacta por WhatsApp para coordinar una visita a Quincho Raíces.'
);
---

<section id="ubicacion" class="py-20 sm:py-28 bg-[#f3f6f4] border-t border-stone-200/80 relative overflow-hidden">
  <!-- Mountain Topographic Elevation Lines Background -->
  <TopographicLines opacity={0.06} strokeColor="#059669" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="reveal-item text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-50 text-emerald-800 text-xs font-bold tracking-wide uppercase mb-3.5 border border-emerald-200 shadow-xs">
        <MapPin className="w-3.5 h-3.5 text-emerald-600" />
        <span>Nuestras Raíces &bull; Entorno & Accesos</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-stone-900 tracking-tight mb-4">
        Ubicación privilegiada en La Punta
      </h2>
      <p class="text-base sm:text-lg text-stone-600 leading-relaxed">
        En el Barrio Aires de San Benito: tranquilidad serrana, aire puro y rápido acceso desde San Luis capital y alrededores.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Info & Quick Access Cards (5 cols) -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-6 relative">
        
        <!-- Subtle botanical branch embracing the location block from top-left -->
        <div class="absolute -top-12 -left-12 sm:-top-8 sm:-left-8 w-60 sm:w-72 pointer-events-none select-none opacity-15 sm:opacity-20 z-0">
          <Image
            src={rootWatercolor2}
            alt="Raíces en La Punta"
            class="w-full h-auto object-contain filter drop-shadow-[0_4px_16px_rgba(5,150,105,0.1)] -rotate-12"
            loading="lazy"
            widths={[240, 360]}
            sizes="288px"
          />
        </div>

        <div class="reveal-item bg-white rounded-3xl p-7 border border-stone-200/90 shadow-md shadow-stone-200/40 hover:border-emerald-300 transition-all duration-300 space-y-6 relative overflow-hidden">
          
          <!-- Decorative root branch embracing the info card from bottom-right -->
          <div class="absolute -bottom-8 -right-8 w-44 sm:w-56 pointer-events-none select-none opacity-20 sm:opacity-25 transition-opacity duration-500 z-0">
            <Image
              src={rootBranch3Emerald}
              alt="Nuestras raíces en La Punta"
              class="w-full h-auto object-contain filter drop-shadow-[0_2px_8px_rgba(5,150,105,0.15)] -rotate-6"
              loading="lazy"
              widths={[180, 240]}
              sizes="(min-width: 640px) 224px, 176px"
            />
          </div>

          <div class="flex items-start gap-4 relative z-10">
            <div class="p-3 rounded-2xl bg-emerald-100 text-emerald-700 flex-shrink-0">
              <MapPin className="w-6 h-6 animate-pulse" />
            </div>
            <div>
              <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-800 text-[11px] font-bold tracking-wide uppercase mb-1.5 border border-emerald-200/70">
                <span>Nuestras raíces en La Punta</span>
              </div>
              <h3 class="text-lg font-serif font-bold text-stone-900">Barrio Aires de San Benito</h3>
              <p class="text-sm text-stone-600 mt-1">
                La Punta, San Luis, Argentina.
              </p>
              <p class="text-xs text-emerald-800 mt-2 font-semibold">
                Zona residencial calma, segura y con vista a las sierras.
              </p>
            </div>
          </div>

          <!-- Key Highlights -->
          <div class="space-y-3 pt-4 border-t border-stone-100 relative z-10">
            <div class="flex items-center gap-3 text-sm text-stone-700 group">
              <Mountain className="w-4 h-4 text-emerald-600 flex-shrink-0 group-hover:scale-110 transition-transform" />
              <span>Vista franca a las sierras de San Luis</span>
            </div>
            <div class="flex items-center gap-3 text-sm text-stone-700 group">
              <Car className="w-4 h-4 text-emerald-600 flex-shrink-0 group-hover:scale-110 transition-transform" />
              <span>Acceso rápido por avenidas principales</span>
            </div>
            <div class="flex items-center gap-3 text-sm text-stone-700 group">
              <Shield className="w-4 h-4 text-emerald-600 flex-shrink-0 group-hover:scale-110 transition-transform" />
              <span>Estacionamiento cerrado dentro del predio</span>
            </div>
          </div>

          <!-- Navigation Action Buttons -->
          <div class="pt-4 border-t border-stone-100 space-y-2.5 relative z-10">
            <a
              href={QUINCHO_INFO.location.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="shimmer-sweep flex items-center justify-between w-full px-4 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold shadow-xs transition-all duration-200 transform hover:-translate-y-0.5 group"
            >
              <div class="flex items-center gap-2">
                <Navigation className="w-4 h-4 text-emerald-100 group-hover:rotate-45 transition-transform duration-200" />
                <span>Abrir en Google Maps</span>
              </div>
              <ExternalLink className="w-4 h-4 text-emerald-100 group-hover:translate-x-0.5 transition-all" />
            </a>

            <a
              href={QUINCHO_INFO.location.wazeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="shimmer-sweep flex items-center justify-between w-full px-4 py-3 rounded-xl bg-white hover:bg-stone-50 text-stone-800 text-sm font-semibold border border-stone-200 hover:border-sky-300 transition-all duration-200 transform hover:-translate-y-0.5 shadow-xs group"
            >
              <div class="flex items-center gap-2">
                <Compass className="w-4 h-4 text-sky-600 group-hover:rotate-45 transition-transform duration-200" />
                <span>Navegar con Waze</span>
              </div>
              <ExternalLink className="w-4 h-4 text-sky-600 group-hover:translate-x-0.5 transition-all" />
            </a>
          </div>

        </div>

        <!-- WhatsApp Location Request -->
        <div class="reveal-item reveal-delay-100 bg-white rounded-3xl p-6 border border-emerald-200 shadow-sm hover:border-emerald-400 transition-colors">
          <h4 class="text-sm font-bold text-stone-900 mb-1">
            ¿Querés venir a conocer el espacio?
          </h4>
          <p class="text-xs text-stone-600 mb-3">
            Escribinos y coordinamos una visita previa para que veas las instalaciones personalmente.
          </p>
          <a
            href={locationWhatsApp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-xs font-bold text-emerald-700 hover:text-emerald-600 underline group"
          >
            <span>Pedir ubicación exacta por WhatsApp</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </a>
        </div>

      </div>

      <!-- Map Embed Container (7 cols) -->
      <div class="reveal-item reveal-delay-200 lg:col-span-7 bg-white rounded-3xl overflow-hidden border border-stone-200/90 shadow-md shadow-stone-200/40 hover:shadow-xl transition-all duration-300 min-h-[360px] lg:min-h-full flex flex-col">
        <div class="p-4 bg-stone-50 border-b border-stone-200 flex items-center justify-between text-xs text-stone-600">
          <span class="font-semibold text-stone-800">Ubicación Oficial &bull; Quincho Raíces</span>
          <span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-semibold border border-emerald-200">Verificado en Google Maps</span>
        </div>
        <div class="relative flex-1 w-full min-h-[350px]">
          <iframe
            title="Ubicación oficial de Quincho Raíces en Google Maps"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13342.304561081682!2d-66.295939!3d-33.2113916!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95d44196ae259ed7%3A0x3b00648b627a6fe!2sQuincho%20%E2%80%9CRa%C3%ADces%E2%80%9D!5e0!3m2!1ses-419!2sar!4v1710972000000!5m2!1ses-419!2sar"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-full min-h-[350px]"
          ></iframe>
        </div>
      </div>

    </div>

  </div>
</section>
