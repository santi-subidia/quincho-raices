---
import { Image } from 'astro:assets';
import { ArrowDown, ChevronDown, MessageCircle } from 'lucide-react';
import AmbientParticles from './AmbientParticles.astro';
import MountainSilhouette from './MountainSilhouette.astro';
import heroBg from '../assets/images/sunset_terrace.jpg';
import { CONTACT_LINES, buildWhatsAppLink } from '../data/quincho';

const [lineRocio, lineMatias] = CONTACT_LINES;
const rocioWhatsApp = buildWhatsAppLink(
  lineRocio.phoneRaw,
  '¡Hola Rocío! Me comunico desde el sitio web de Quincho Raíces para consultar por disponibilidad de fechas.'
);
const matiasWhatsApp = buildWhatsAppLink(
  lineMatias.phoneRaw,
  '¡Hola Matías! Me comunico desde el sitio web de Quincho Raíces para consultar por disponibilidad de fechas.'
);
---

<section id="hero" class="relative min-h-[92vh] flex items-center justify-center overflow-hidden bg-[#080a09] text-white pb-14 sm:pb-20">
  <!-- Background Image with Ambient Particles & Gradient Overlay -->
  <div class="absolute inset-0 z-0">
    <Image
      src={heroBg}
      alt="Quincho Raíces atardecer con vista a las sierras de San Luis"
      class="w-full h-full object-cover object-center scale-105 transition-transform duration-1000 ease-out"
      loading="eager"
      widths={[640, 1024, 1920]}
      sizes="100vw"
    />
    <!-- Multi-stop gradient for maximum text contrast and elegance -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#080a09] via-[#080a09]/80 to-[#080a09]/55"></div>
    <div class="absolute inset-0 bg-radial-gradient from-transparent to-[#080a09]/50"></div>
    
    <!-- Sunset Horizon Twilight Glow behind the mountain ridges -->
    <div class="absolute bottom-0 left-0 right-0 h-64 bg-gradient-to-t from-amber-600/25 via-emerald-950/20 to-transparent pointer-events-none"></div>

    <!-- Organic Ambient Particles (Fireflies / Sunset Spores) -->
    <AmbientParticles count={20} theme="emerald" />
  </div>

  <!-- Hero Content: Limpio, Editorial y con Invitación Magnética -->
  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 pb-16 sm:pt-36 sm:pb-20 text-center flex flex-col items-center justify-center">
    
    <!-- Supra-title: Contexto geográfico y exclusividad sin ruido -->
    <p class="reveal-item text-[11px] sm:text-xs font-semibold tracking-[0.28em] uppercase text-emerald-400/90 mb-4 sm:mb-6">
      Predio Privado &bull; La Punta, San Luis
    </p>

    <!-- Main Title with Editorial Serif Font -->
    <h1 class="reveal-item reveal-delay-100 font-serif text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-white leading-[1.16] max-w-4xl text-balance drop-shadow-2xl mb-8 sm:mb-10">
      El lugar donde tus festejos se convierten en <span class="bg-gradient-to-r from-emerald-300 via-emerald-400 to-teal-200 bg-clip-text text-transparent italic font-normal">momentos inolvidables</span>
    </h1>

    <!-- Action Bar: Exploración principal y opción de contacto con Rocío o Matías -->
    <div class="reveal-item reveal-delay-200 flex flex-col items-center justify-center gap-4 mb-10 sm:mb-12 w-full">
      
      <!-- Botón Principal: Explorar el espacio -->
      <a
        href="#amenities"
        class="shimmer-sweep w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-full bg-emerald-700 hover:bg-emerald-600 text-white font-medium text-sm tracking-wide shadow-[0_0_20px_rgba(16,185,129,0.3)] transition-all transform hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
      >
        <span>Explorar el espacio</span>
        <ArrowDown className="w-4 h-4 text-emerald-200" />
      </a>

      <!-- Consultar disponibilidad: Opciones con Rocío o con Matías -->
      <div class="flex items-center justify-center gap-2 pt-1 flex-wrap text-xs text-stone-300">
        <span class="text-stone-400 font-normal mr-1">Consultar disponibilidad:</span>
        <a
          href={rocioWhatsApp}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-white/5 hover:bg-emerald-950/80 text-stone-200 hover:text-white border border-white/15 hover:border-emerald-500/50 font-medium transition-all hover:scale-105 active:scale-95"
        >
          <MessageCircle className="w-3.5 h-3.5 text-emerald-400" />
          <span>Con Rocío</span>
        </a>
        <a
          href={matiasWhatsApp}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-white/5 hover:bg-emerald-950/80 text-stone-200 hover:text-white border border-white/15 hover:border-emerald-500/50 font-medium transition-all hover:scale-105 active:scale-95"
        >
          <MessageCircle className="w-3.5 h-3.5 text-emerald-400" />
          <span>Con Matías</span>
        </a>
      </div>

    </div>

    <!-- Discovery Anchors: Pistas discretas de lo que encontrarán abajo -->
    <div class="reveal-item reveal-delay-300 flex items-center justify-center gap-3 sm:gap-5 text-xs text-stone-300/80 tracking-wide font-normal flex-wrap">
      <span>Salón para 40</span>
      <span class="w-1 h-1 rounded-full bg-emerald-500/60 hidden sm:inline-block"></span>
      <span>Piscina con vistas</span>
      <span class="w-1 h-1 rounded-full bg-emerald-500/60 hidden sm:inline-block"></span>
      <span>Parrilla & Asador</span>
      <span class="w-1 h-1 rounded-full bg-emerald-500/60 hidden sm:inline-block"></span>
      <span>Uso 100% exclusivo</span>
    </div>

  </div>

  <!-- Mountain Silhouette Transition into Next Section -->
  <div class="absolute bottom-0 left-0 right-0 z-20 pointer-events-none">
    <MountainSilhouette variant="sunset" fillColor="#080a09" />
  </div>

  <!-- Scroll Down Indicator -->
  <a
    href="#amenities"
    aria-label="Lo que ofrecemos"
    class="absolute bottom-2 sm:bottom-4 left-1/2 -translate-x-1/2 z-30 p-2 text-emerald-400/80 hover:text-emerald-300 transition-colors duration-200 animate-bounce"
  >
    <ChevronDown className="w-6 h-6" />
  </a>
</section>
