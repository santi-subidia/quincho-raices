---
import { Image } from 'astro:assets';
import { ArrowDown, MessageCircle, Sparkles, Eye } from 'lucide-react';
import AmbientParticles from './AmbientParticles.astro';
import MountainSilhouette from './MountainSilhouette.astro';
import heroBg from '../assets/images/sunset_terrace.jpg';
import { CONTACT_LINES, buildWhatsAppLink } from '../data/quincho';
import { HeroTextRotator } from './HeroTextRotator';

const [lineRocio, lineMatias] = CONTACT_LINES;
const rocioWhatsApp = buildWhatsAppLink(
  lineRocio.phoneRaw,
  '¡Hola Rocío! Me comunico desde el sitio web de Quincho Raíces para consultar por disponibilidad de fechas.'
);
const matiasWhatsApp = buildWhatsAppLink(
  lineMatias.phoneRaw,
  '¡Hola Matías! Me comunico desde el sitio web de Quincho Raíces para consultar por disponibilidad de fechas.'
);
---

<section id="hero" class="relative min-h-[90vh] flex items-center justify-center overflow-hidden bg-white text-stone-900 pb-16 sm:pb-24">
  <!-- Background Image with Warm, Luminous Gradient Overlay -->
  <div class="absolute inset-0 z-0">
    <Image
      src={heroBg}
      alt="Quincho Raíces al atardecer con vista a las sierras de San Luis"
      class="w-full h-full object-cover object-center scale-102 transition-transform duration-1000 ease-out"
      loading="eager"
      widths={[640, 1024, 1920]}
      sizes="100vw"
    />
    
    <!-- Warm, light multi-stop gradient overlay allowing landscape visibility while ensuring high text contrast -->
    <div class="absolute inset-0 bg-gradient-to-b from-white/85 via-white/70 to-[#f8faf9]"></div>
    <div class="absolute inset-0 bg-radial-gradient from-amber-100/20 via-transparent to-emerald-900/10"></div>
    
    <!-- Warm sunset gold ambient glow -->
    <div class="absolute bottom-0 left-0 right-0 h-48 bg-gradient-to-t from-[#f8faf9] via-amber-50/40 to-transparent pointer-events-none"></div>

    <!-- Organic Ambient Warm Particles -->
    <AmbientParticles count={16} theme="emerald" />
  </div>

  <!-- Hero Content: Luminoso, Conciso y Directo al grano -->
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-14 sm:pt-32 sm:pb-20 text-center flex flex-col items-center justify-center">
    
    <!-- Badge Superior Conciso -->
    <div class="reveal-item inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-50 text-emerald-800 text-xs sm:text-xs font-bold tracking-wider uppercase mb-5 border border-emerald-200/90 shadow-xs">
      <Sparkles className="w-3.5 h-3.5 text-emerald-600" />
      <span>SALÓN DE EVENTOS & QUINCHO EXCLUSIVO • LA PUNTA, SAN LUIS</span>
    </div>

    <!-- Main Title Directo, Cálido y Dinámico con Motion -->
    <h1 class="reveal-item reveal-delay-100 font-serif text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-stone-900 leading-[1.2] max-w-3xl text-balance mb-5 sm:mb-6">
      El lugar perfecto para tus{' '}
      <HeroTextRotator client:load />
    </h1>

    <!-- Subtítulo Breve y Claro -->
    <p class="reveal-item reveal-delay-100 text-base sm:text-lg md:text-xl text-stone-700 font-normal leading-relaxed max-w-2xl text-balance mb-8 sm:mb-10">
      Capacidad hasta 40 personas. Piscina, parque serrano, parrilla completa y vajilla incluida sin costo extra.
    </p>

    <!-- Botones de Acción Principales -->
    <div class="reveal-item reveal-delay-200 flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-4 mb-8 sm:mb-10 w-full sm:w-auto">
      
      <!-- CTA 1: Consultar por WhatsApp -->
      <a
        href={rocioWhatsApp}
        target="_blank"
        rel="noopener noreferrer"
        class="shimmer-sweep w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm sm:text-base tracking-wide shadow-lg shadow-emerald-600/25 transition-all transform hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
      >
        <MessageCircle className="w-5 h-5 text-emerald-100" />
        <span>Consultar por WhatsApp</span>
      </a>

      <!-- CTA 2: Ver Instalaciones (scroll a #amenities) -->
      <a
        href="#amenities"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-white hover:bg-stone-50 text-stone-800 font-semibold text-sm sm:text-base border border-stone-300/80 shadow-xs hover:border-emerald-400 transition-all transform hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
      >
        <Eye className="w-4 h-4 text-emerald-600" />
        <span>Ver Instalaciones</span>
      </a>
    </div>

    <!-- Contacto Directo Rápido -->
    <div class="reveal-item reveal-delay-200 flex items-center justify-center gap-2 flex-wrap text-xs text-stone-600 mb-8">
      <span class="font-medium text-stone-500">¿Consultas inmediatas? Escribile a:</span>
      <a
        href={rocioWhatsApp}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white hover:bg-emerald-50 text-stone-700 hover:text-emerald-700 border border-stone-200 hover:border-emerald-300 font-semibold transition-all shadow-2xs"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Rocío</span>
      </a>
      <span class="text-stone-300">•</span>
      <a
        href={matiasWhatsApp}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white hover:bg-emerald-50 text-stone-700 hover:text-emerald-700 border border-stone-200 hover:border-emerald-300 font-semibold transition-all shadow-2xs"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Matías</span>
      </a>
    </div>

    <!-- Chips Destacados Concisos Abajo -->
    <div class="reveal-item reveal-delay-300 flex items-center justify-center gap-2 sm:gap-3 flex-wrap">
      {[
        'Salón para 40',
        'Piscina y solárium',
        'Parrilla y cocina industrial',
        'Uso 100% exclusivo',
      ].map((chip) => (
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white/95 text-stone-700 text-xs sm:text-xs font-semibold border border-stone-200/90 shadow-2xs">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>{chip}</span>
        </span>
      ))}
    </div>

  </div>

  <!-- Mountain Silhouette Transition into Next Section -->
  <div class="absolute bottom-0 left-0 right-0 z-20 pointer-events-none">
    <MountainSilhouette variant="sunset" fillColor="#f8faf9" />
  </div>
</section>
