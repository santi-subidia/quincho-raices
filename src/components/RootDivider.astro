---
interface Props {
  flip?: boolean;
  className?: string;
  isDark?: boolean;
}

const { flip = false, className = '', isDark = false } = Astro.props;
---

<div
  class={`relative w-full flex items-center justify-center py-4 overflow-hidden pointer-events-none ${className} ${
    flip ? 'scale-x-[-1]' : ''
  }`}
  aria-hidden="true"
>
  <svg
    class="w-full max-w-4xl h-10 opacity-75"
    viewBox="0 0 800 50"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- Central Organic Root Runner -->
    <path
      d="M0 25 C150 25, 220 18, 320 28 C400 36, 460 16, 560 26 C640 34, 700 24, 800 25"
      stroke={isDark ? 'rgba(52, 211, 153, 0.4)' : 'rgba(52, 120, 90, 0.35)'}
      stroke-width="2"
      stroke-linecap="round"
      fill="none"
    />

    <!-- Secondary Twig 1 -->
    <path
      d="M260 23 C280 12, 305 8, 325 10"
      stroke={isDark ? 'rgba(52, 211, 153, 0.5)' : 'rgba(52, 120, 90, 0.4)'}
      stroke-width="1.5"
      stroke-linecap="round"
      fill="none"
    />
    <!-- Sprout Leaf 1 -->
    <circle
      cx="326"
      cy="10"
      r="2.5"
      fill={isDark ? '#6ee7b7' : '#34d399'}
    />

    <!-- Secondary Twig 2 (Descending) -->
    <path
      d="M480 21 C505 32, 530 38, 555 35"
      stroke={isDark ? 'rgba(52, 211, 153, 0.5)' : 'rgba(52, 120, 90, 0.4)'}
      stroke-width="1.5"
      stroke-linecap="round"
      fill="none"
    />
    <!-- Sprout Leaf 2 -->
    <circle
      cx="556"
      cy="35"
      r="2.5"
      fill={isDark ? '#6ee7b7' : '#34d399'}
    />

    <!-- Subtle Center Sprout Cluster -->
    <path
      d="M395 34 C402 38, 412 37, 416 32"
      stroke={isDark ? 'rgba(52, 211, 153, 0.45)' : 'rgba(52, 120, 90, 0.35)'}
      stroke-width="1.2"
      fill="none"
    />
    <circle
      cx="416"
      cy="32"
      r="2"
      fill={isDark ? '#a7f3d0' : '#10b981'}
    />
  </svg>
</div>
