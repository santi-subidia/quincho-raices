---
import { Image } from 'astro:assets';
import rootBranch2Emerald from '../assets/images/roots/root_branch_2_emerald.png';
import rootBranch2Charcoal from '../assets/images/roots/root_branch_2_charcoal.png';
import rootWatercolor1 from '../assets/images/roots/root_watercolor_1.png';

interface Props {
  flip?: boolean;
  className?: string;
  isDark?: boolean;
  variant?: 'emerald' | 'charcoal' | 'watercolor';
}

const {
  flip = false,
  className = '',
  isDark = false,
  variant = isDark ? 'emerald' : 'emerald',
} = Astro.props;

// Determine branch image based on variant
let rootImage = rootBranch2Emerald;
if (variant === 'watercolor') {
  rootImage = rootWatercolor1;
} else if (variant === 'charcoal') {
  rootImage = rootBranch2Charcoal;
}
---

<div
  class={`relative w-full flex items-center justify-center py-6 sm:py-8 overflow-hidden pointer-events-none select-none z-10 ${className}`}
  aria-hidden="true"
>
  <div class="max-w-6xl w-full mx-auto px-4 flex items-center justify-center gap-3 sm:gap-6">
    <!-- Left Fading Gradient Line -->
    <div
      class={`h-[1px] flex-1 max-w-[140px] sm:max-w-xs md:max-w-sm transition-opacity duration-300 ${
        isDark
          ? 'bg-gradient-to-r from-transparent via-emerald-400/30 to-emerald-400/60'
          : 'bg-gradient-to-r from-transparent via-emerald-600/20 to-emerald-600/40'
      }`}
    ></div>

    <!-- Center Root Branch with Glow Effect -->
    <div
      class={`relative flex items-center justify-center shrink-0 transition-transform duration-500 ${
        flip ? '-scale-x-100' : ''
      }`}
    >
      <!-- Ambient Radial Aura -->
      <div
        class={`absolute -inset-2 sm:-inset-4 rounded-full blur-xl pointer-events-none ${
          isDark
            ? 'bg-emerald-400/15'
            : 'bg-emerald-500/10'
        }`}
      ></div>

      <!-- High-resolution Transparent Root Image -->
      <Image
        src={rootImage}
        alt="Raíces decorativas de Quincho Raíces"
        class={`relative z-10 w-44 sm:w-64 md:w-80 lg:w-96 h-auto object-contain transition-all duration-300 ${
          isDark
            ? 'opacity-85 filter drop-shadow-[0_0_12px_rgba(52,211,153,0.35)]'
            : 'opacity-80 filter drop-shadow-[0_2px_8px_rgba(5,150,105,0.18)]'
        }`}
        widths={[280, 480, 768]}
        sizes="(min-width: 1024px) 384px, (min-width: 768px) 320px, 240px"
        loading="lazy"
      />
    </div>

    <!-- Right Fading Gradient Line -->
    <div
      class={`h-[1px] flex-1 max-w-[140px] sm:max-w-xs md:max-w-sm transition-opacity duration-300 ${
        isDark
          ? 'bg-gradient-to-l from-transparent via-emerald-400/30 to-emerald-400/60'
          : 'bg-gradient-to-l from-transparent via-emerald-600/20 to-emerald-600/40'
      }`}
    ></div>
  </div>
</div>
